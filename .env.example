APP_NAME=ACL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# MariaDB is the engine for the test suite and for production (ADR-0005), and
# the zero-config default the devcontainer provisions for a fresh clone.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acl
DB_USERNAME=acl_user
DB_PASSWORD=

# Development runtime alternative: TiDB Cloud Serverless over TLS (ADR-0007).
# When the ACL_TIDB_* Codespaces secrets are present the devcontainer points
# the app here instead -- MySQL wire protocol, so DB_CONNECTION=mysql:
#   DB_CONNECTION=mysql
#   DB_HOST=<gateway>.tidbcloud.com
#   DB_PORT=4000
#   DB_DATABASE=<database>
#   DB_USERNAME=<prefix>.root
#   DB_PASSWORD=<secret>          # a real value never belongs in this file

# Path to a CA bundle, required when reaching a managed MariaDB or TiDB over
# TLS. Laravel ignores ?ssl-mode= in a DB_URL, so set this instead.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Alternative to the discrete DB_* values above. Note the name is DB_URL,
# not DATABASE_URL -- Laravel does not read DATABASE_URL.
# DB_URL=

# database drivers are the portable zero-infra default: a plain clone needs
# only the DB it already requires. The devcontainer overrides these three to
# redis (ADR-0008); to do the same on a local install, run a Redis server,
# switch the drivers, and fill the REDIS_* block below.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Redis backs sessions, cache and queue when enabled (ADR-0008). predis is the
# pure-PHP client ACL uses -- no compiled extension needed. db0 holds sessions
# and the queue, db1 the cache, kept apart so cache:clear cannot evict a live
# session. The devcontainer sets these automatically.
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null
# REDIS_DB=0
# REDIS_CACHE_DB=1

# log is the portable default -- mail is written to the log, nothing is sent.
# The devcontainer overrides to Mailpit (SMTP on :1025 with AUTH, inbox :8025)
# so the real SMTP path is exercised without anything leaving the container.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
